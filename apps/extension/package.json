    "@cognitive-os/ui": "workspace:*",
    "@cognitive-os/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
