# Environment Variables — CognitiveOS
# Copy to .env and fill in real values

# ============================
# APP
# ============================
NODE_ENV=development
APP_NAME=CognitiveOS

# ============================
# API SERVER
# ============================
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-here
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,chrome-extension://

# ============================
# LLM PROVIDERS (OpenAI, Groq, Ollama, etc.)
# ============================
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ============================
# POSTGRESQL
# ============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cognitive_os
POSTGRES_USER=cognitive_user
POSTGRES_PASSWORD=your-db-password
DATABASE_URL=postgresql://cognitive_user:your-db-password@localhost:5432/cognitive_os

# ============================
# REDIS
# ============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============================
# AUTH (Clerk)
# ============================
CLERK_SECRET_KEY=sk_test_your-clerk-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ============================
# NEXT.JS WEB APP
# ============================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
